serviceAccount:
  create: true
  tokenAutomount: false

stunner:
  enabled: false

# Mandatory. Can be deployment or distributed
mode: deployment

services:
  openvidu:
    enabled: true
    type: master
    image:
      repository: openvidu/openvidu-server
      tag: 2.30.0
      pullPolicy: IfNotPresent
    port: 443
    configDir: /opt/openvidu/
    secret: openvidu
    pro:
      enabled: false
    protocols:
      - TCP
    ssl:
      enabled: false
      certType: owncert
    kms:
      uris:
        - "ws://localhost:8888/kurento"
    coturn:
      ip: "turn.develop.jaraxa.systems"
      port: 3478
      uris: "turns:turns.develop.jaraxa.systems:443"
      iceServers: 
        - turns:turns.develop.jaraxa.systems:443,username=turn,credential=jaraxa
        - turns:turns.develop.jaraxa.systems:5349,username=turn,credential=jaraxa 
        - turn:turns.develop.jaraxa.systems:3478,username=turn,credential=jaraxa        
    transcoding:
      enabled: false
    webhook:
      enabled: true
      endpoint: "https://develop.jaraxa.systems/pet/api/v1/webhooks/openvidu"
      headers: '["Brand: DKV", "Product: Openvidu", "x-pet-app-id: dfcd90b3", "x-pet-app-secret: 3a7e1ecf-59d0-4432-a322-8add3cf3c914"]'
      events: '["sessionCreated", "sessionDestroyed", "participantJoined", "participantLeft", "webrtcConnectionCreated", "webrtcConnectionDestroyed", "recordingStatusChanged", "filterEventDispatched", "signalSent"]'
    cdr:
      enabled: false
      path: /opt/openvidu/cdr
    env: {}

  kms:
    enabled: true
    type: media
    image:
      repository: kurento/kurento-media-server
      tag: 7.0.1
      pullPolicy: IfNotPresent
    protocols:
      - TCP
    port: 8888
    env:
      KURENTO_LOGS_PATH: "/var/log/kurento-media-server/"
      KMS_MIN_PORT: "40000"
      KMS_MAX_PORT: "45000"

ingress:
  enabled: true
  class: nginx
  annotations:
    nginx.ingress.kubernetes.io/rewrite-target: /$1
  paths:
    - /(.*)
  hosts:
    - "{{ requiredEnv "APP_NAME" }}-pr{{ requiredEnv "PULL_NUMBER" }}.{{ .Values.jxRequirements.ingress.domain }}"
  tls:
{{- if and (.Values.jxRequirements.ingress.tls.enabled) (hasKey .Values.jxRequirements.ingress "tls") (hasKey .Values.jxRequirements.ingress.tls "secretName") }} 
    - secretName: "{{ .Values.jxRequirements.ingress.tls.secretName }}"
      hosts:
        - "{{ requiredEnv "APP_NAME" }}-pr{{ requiredEnv "PULL_NUMBER" }}.{{ .Values.jxRequirements.ingress.domain }}"
{{- else if .Values.jxRequirements.ingress.tls.production }}
    - secretName: "tls-{{ .Values.jxRequirements.ingress.domain | replace "." "-" }}-p"
      hosts:
        - "{{ requiredEnv "APP_NAME" }}-pr{{ requiredEnv "PULL_NUMBER" }}.{{ .Values.jxRequirements.ingress.domain }}"
{{- else }}
    - secretName: "tls-{{ .Values.jxRequirements.ingress.domain | replace "." "-" }}-s"
      hosts:
        - "{{ requiredEnv "APP_NAME" }}-pr{{ requiredEnv "PULL_NUMBER" }}.{{ .Values.jxRequirements.ingress.domain }}"
{{- end }}